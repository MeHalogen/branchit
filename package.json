{
  "name": "branchy",
  "version": "0.1.0",
  "description": "Git flow without the command flow. A fast, safe, keyboard-first TUI for everyday Git workflows.",
  "type": "module",
  "bin": {
    "branchy": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node --import tsx src/cli.tsx",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:repo": "node --import tsx scripts/demo-repo.ts"
  },
  "dependencies": {
    "execa": "^9.5.1",
    "ink": "^5.1.0",
    "react": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
