{
  "name": "branchit",
  "version": "0.2.0",
  "description": "Git flow without the command flow. A fast, safe, keyboard-first TUI for everyday Git workflows.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "branchit": "./dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeHalogen/branchit.git"
  },
  "bugs": {
    "url": "https://github.com/MeHalogen/branchit/issues"
  },
  "homepage": "https://github.com/MeHalogen/branchit#readme",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node --import tsx src/cli.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:repo": "node --import tsx scripts/demo-repo.ts",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build",
    "demo:gif": "npm run build && vhs demo.tape",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "execa": "^9.5.1",
    "ink": "^5.1.0",
    "react": "^18.3.1",
    "smol-toml": "^1.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
